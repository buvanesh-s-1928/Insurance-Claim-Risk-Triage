  },
  {
   "column": "Fault",
   "reason": "May be decided during claim handling, so it may not exist at intake. Without it, scores are lower but defensible."
  },
  {
   "column": "NumberOfSuppliments",
   "reason": "Counts extra payments made after the claim, so it is known only later."
  },
